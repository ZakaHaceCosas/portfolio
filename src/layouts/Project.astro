---
import ToC from "../components/ToC.astro";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---

<Layout>
    <h1 class="animation">
        <span style="font-weight: 400;"><a href="/">Zaka</a>\</span><span style="font-weight: 400;"
            ><a href="/projects"><eng>Projects</eng><esp>Proyectos</esp></a></span
        >\<esp>{frontmatter.titleES}</esp><eng>{frontmatter.titleEN}</eng>
    </h1>
    <hr />
        <div  style="display: flex; flex-direction: row; gap: 12px;">
            <ToC chapters={frontmatter.chapters} />
            <div style="display: flex; flex-direction: column; gap: 6px; ">
                <div style="display: flex; flex-direction: row; gap: 12px; ">
                    <img style="max-width: 700px; border-radius: 6px;" class="animation" src={`/covers/${frontmatter.id}.png`} alt="Project cover" style="width: 100%;" />
                    <p  class="animation"><em style="font-size: xx-large">
                        <esp>{frontmatter.descriptionES}</esp><eng>{frontmatter.descriptionEN}</eng>
                    </em><br/>&mdash; <esp>Proyecto de ZakaHaceCosas</esp><eng>ZakaHaceCosas’ project</eng></p>
                </div>
                <slot  />
            </div>
        </div>
</Layout>
