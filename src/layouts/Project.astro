---
import HeadProvider from "../components/HeadProvider.astro";
import ToC from "../components/ToC.astro";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---

<HeadProvider
    title={frontmatter.titleES}
    description={frontmatter.description}
    banner_url={`https://me.zhc.es/covers/${frontmatter.id}.png`}
/>

<Layout>
    <h1 class="animation">
        <span style="font-weight: 400;"><a href="/">Zaka</a>\</span><span style="font-weight: 400;"
            ><a href="/projects"><eng>Projects</eng><esp>Proyectos</esp></a></span
        >\<esp>{frontmatter.titleES}</esp><eng>{frontmatter.titleEN}</eng>
    </h1>
    <hr />
        <div style="display: flex; flex-direction: row; gap: 12px;">
            <ToC chapters={frontmatter.chapters} />
            <div style="display: flex; flex-direction: column; gap: 12px; ">
                <div style="display: flex; flex-direction: row; gap: 12px; ">
                    <img style="max-width: 500px; border-radius: 6px;" class="animation" src={`/covers/${frontmatter.id}.png`} alt="Project cover" style="width: 100%;" />
                    <p  class="animation"><em style="font-size: xx-large">
                        <esp>{frontmatter.descriptionES}</esp><eng>{frontmatter.descriptionEN}</eng>
                    </em><br/>&mdash; <esp>Descripción del proyecto</esp><eng>Project page</eng></p>
                </div>
                <hr style="height: 2px; background-color: #00000020;" class="animation" />
                <div style="max-width:1000px;"><slot  /></div>
            </div>
        </div>
</Layout>
