---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import ZakaBox from "../components/ZakaBox.astro";
import Projects from "../components/Projects.astro";
import Showcase from "../components/Showcase.astro";
import HeadProvider from "../components/HeadProvider.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<HeadProvider />

<Layout>
    <h1 class="animation">
        <esp>
            <span style="font-weight: 600">Buenos días, tardes, noches o cuando sea que estés aquí.</span><br />
            <span style="font-weight: 400">Soy Zaka y Hago Cosas.</span>
        </esp>
        <eng>
            <span style="font-weight: 600">Good morning, afternoon, night or whenever you're here.</span><br />
            <span style="font-weight: 400">I'm Zaka and I Make Stuff.</span>
        </eng>
    </h1>

    <h2>
        <esp>Proyectos</esp>
        <eng>Projects</eng>
    </h2>

    <div class="showcase">
        <Showcase
            id="kantra"
            label={{ esp: "Kantra, el software de gestión de accesos", eng: "Kantra, the accesses control software" }}
            desc={{
                eng: "A self-host-first, web-based Access Control System for education institutions.",
                esp: "Un Sistema de Acceso Controlado, pensado para self-hosting y basado en la web, para instituciones educativas.",
            }}
        />
        <Showcase
            id="sokora"
            label={{
                esp: "Sokora, el bot de Discord multi-propósito",
                eng: "Sokora, the multipurpose Discord bot",
            }}
            desc={{
                eng: "A free, complete and intuitive bot; based on discord.js.",
                esp: "Un bot gratuito, completo e intuitivo; basado en discord.js.",
            }}
        />
        <div class="animation showcased" style="cursor: default;">
            <esp>
                <p>Pronto más.</p>
            </esp>
            <eng>
                <p>Soon more.</p>
            </eng>
        </div>
    </div>
    <h2>
        <esp>Qué sé hacer</esp>
        <eng>What I know to do</eng>
    </h2>

    <div class="zakaBox skill-box">
        <p>
            <esp>Habilidades</esp>
            <eng>Skills</eng>
        </p>
        <div class="all-skills">
            <div class="skill animation">
                <Icon name="FIGMA" width={40} height={40} />
                <p>
                    <esp>Diseño de interfaces con Figma</esp>
                    <eng>Interface design with Figma</eng>
                </p>
            </div>
            <div class="skill animation">
                <Icon name="JAVASCRIPT-BUT-BETTER" width={40} height={40} />
                <p>
                    <esp>Desarrollo en TypeScript</esp>
                    <eng>Developing in TypeScript</eng>
                </p>
            </div>
            <div class="skill animation">
                <Icon name="SVELTE" width={40} height={40} />
                <p>
                    <esp>Aplicaciones simples con Svelte</esp>
                    <eng>Simple apps with Svelte</eng>
                </p>
            </div>
            <div class="skill animation">
                <Icon name="DOTNET" width={40} height={40} />
                <p>
                    <esp>Básicos de C# y dotNET</esp>
                    <eng>Basics of C# and dotNET</eng>
                </p>
            </div>
            <div class="skill animation">
                <Icon name="REACT" width={40} height={40} />
                <p>
                    <esp>Básicos de ReactJS</esp>
                    <eng>Basics of ReactJS</eng>
                </p>
            </div>
        </div>
    </div>

    <div>
        <h2 id="work">
            <esp>Detalles profesionales</esp>
            <eng>Professional details</eng>
        </h2>
        <p>
            <esp>Aquí sale mi experiencia académica y laboral, por si te interesa.</esp>
            <eng>Here's my academic and professional experience appear, in case it interests you.</eng>
        </p>
    </div>

    <div class="bento">
        <ZakaBox
            url="https://www.linkedin.com/in/zakahacecosas/"
            name="LinkedIn"
            boxIcon={{
                type: "svg",
                name: "in",
            }}
            boxClass="box-in"
            desc={{
                esp: "Información profesional.",
                eng: "Professional information.",
            }}
        />
        <p>
            <eng>
                I am still studying and therefore not available for full-time work, however <b
                    >I do accept commissions and small pieces of work</b
                >, with prices to be negotiated (or even free in exchange of crediting me, depending on the case).
            </eng>
            <esp>
                Sigo estudiando y por tanto no estoy disponible para trabajo a tiempo completo, sin embargo <b
                    >sí acepto comisiones y trabajos pequeños</b
                >, con paga a negociar (o incluso gratis a cambio de acreditación, según el caso).
            </esp>
        </p>
    </div>

    <Projects />

    <div>
        <h2 id="contact">
            <esp>Contacto y redes sociales</esp>
            <eng>Contact and social media</eng>
        </h2>
        <p>
            <esp>soy algo inactivo en la mayoría, si buscas contactarme usa Discord o el correo-e</esp>
            <eng>im somewhat inactive in most of them, for contact use Discord or e-mail</eng>
        </p>
    </div>
    <div class="bento">
        <ZakaBox
            url="https://discord.com/users/1136046074700771400/"
            name="Discord"
            boxIcon={{
                type: "svg",
                name: "discord",
            }}
            boxClass="box-dc"
            desc={{
                esp: "Contacta conmigo aquí.",
                eng: "Contact me here.",
            }}
        />
        <ZakaBox
            url="https://github.com/ZakaHaceCosas/"
            name="GitHub"
            boxIcon={{
                type: "svg",
                name: "git",
            }}
            boxClass="box-gh"
            desc={{
                esp: "Aquí alojo (casi) todo mi código.",
                eng: "Here I host all(most) my code.",
            }}
        />
        <ZakaBox
            url="https://gitlab.com/zakahacecosas"
            name="GitLab"
            boxIcon={{
                type: "svg",
                name: "cat",
            }}
            boxClass="box-cat"
        />
        <ZakaBox
            url="https://codeberg.org/zakahacecosas"
            name="Codeberg"
            boxIcon={{
                type: "svg",
                name: "codeberg",
            }}
            boxClass="box-codeberg"
        />
        <!--<ZakaBox
            url="https://youtube.com/@ZakaHaceCosas/"
            name="YouTube"
            boxIcon={{
                type: "svg",
                name: "yt",
            }}
            boxClass="box-yt"
        /> -->
        <ZakaBox
            url="https://x.com/ZakaHaceCosas/"
            name="Twitter"
            boxIcon={{
                type: "svg",
                name: "not-x",
            }}
            boxClass="box-x"
        />
        <ZakaBox
            url="https://bsky.app/profile/zakahacecosas.bsky.social"
            name="Bluesky"
            boxIcon={{
                type: "svg",
                name: "sky",
            }}
            boxClass="box-sky"
        />
    </div>
</Layout>
